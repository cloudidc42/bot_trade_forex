# Environment Configuration
# คัดลอกไฟล์นี้เป็น .env และกรอกค่าจริง

# ========================================
# GENERAL SETTINGS
# ========================================
ENV=dev  # dev, paper, live
LOG_LEVEL=INFO
TZ=Asia/Bangkok

# ========================================
# CRYPTO EXCHANGE APIs (CCXT)
# ========================================
# Binance
BINANCE_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here
BINANCE_TESTNET=true

# Coinbase
COINBASE_KEY=your_coinbase_key_here
COINBASE_SECRET=your_coinbase_secret_here

# FTX / Other
FTX_KEY=
FTX_SECRET=

# ========================================
# FOREX (MetaTrader 5)
# ========================================
MT5_LOGIN=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_broker_server
MT5_PATH=/path/to/terminal64.exe

# ========================================
# STOCKS / COMMODITIES
# ========================================
# Interactive Brokers
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# Alpaca (US Stocks)
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_PAPER=true

# ========================================
# DATABASE
# ========================================
DB_TYPE=postgresql  # postgresql, sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_bot
DB_USER=trader
DB_PASSWORD=secure_password_here

# SQLite (alternative)
SQLITE_PATH=./data/trading.db

# ========================================
# RISK MANAGEMENT
# ========================================
MAX_DAILY_LOSS_PCT=2.0
MAX_POSITION_SIZE_PCT=5.0
MAX_TOTAL_EXPOSURE_PCT=30.0
LEVERAGE_MAX=3.0

# ========================================
# MONITORING
# ========================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_WEBHOOK=

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ========================================
# BACKTEST SETTINGS
# ========================================
BACKTEST_START_DATE=2020-01-01
BACKTEST_END_DATE=2023-12-31
INITIAL_CAPITAL=100000
COMMISSION_PCT=0.001
SLIPPAGE_PCT=0.0005
